<?xml version="1.0" encoding="UTF-8"?>
<!-- officia-demo：独立消费方项目。模拟真实客户，通过 Maven 坐标引入已发布的 officia 依赖，
     写示例演示各能力使用 + JUnit 验证。不属于 officia reactor（同级独立目录）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>plus.ruoyi.demo</groupId>
    <artifactId>officia-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Officia Demo</name>
    <description>officia 依赖消费示例：引入 officia-all + officia-license，演示各能力使用与授权门控</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          全家桶：一次引入即得全部能力模块（words/cells/slides/pdf/email/imaging/barcode）
          外加授权客户端（OfficiaLicense 门面 + 内嵌验签公钥）。

          这是**唯一**需要引的 officia 依赖：Maven Central 上只发布 officia-all 这一个 artifact，
          它是 shade 出来的 uber-jar（含 632 个类），各能力模块与 officia-license 都已打进去。
          此前本 pom 还单列了一条 officia-license —— 那在本机 mvn install 后能解析，
          但客户照抄就是 404（Central 上没有这个 artifact）。别再加回来。
        -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>officia-all</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 固定已缓存版本，保证离线可跑（与 officia 父 pom 一致） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 打成可直接 `java -jar` 运行的自包含 jar（把 officia 各模块一起打进来），
                 主类 = 测试台服务入口。shade 是构建期插件，不改变"运行时只依赖 JDK + officia"的事实。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>plus.ruoyi.officia.demo.web.DemoServer</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
