# Officia 测试台容器编排 —— 环境变量样例
# 用法：cp .env.example .env，按需修改。.env 不入库。

# 宿主侧端口
HOST_PORT=18080

# 发布地址（🔴 测试台无鉴权，改之前想清楚谁能访问到）：
#   127.0.0.1 = 只有宿主本机可达（默认，最安全；远程访问走 SSH 隧道）
#   0.0.0.0   = 同网段/VPN 内任意机器可直接打开，无需隧道
BIND_ADDR=127.0.0.1

# 容器内存上限。它决定 JVM 堆，进而决定单次上传上限（堆 ÷ 8，夹在 [64MB, 1GB]）：
#   2g → 堆约 1.5g → 上传上限约 192MB
#   4g → 堆约 3g   → 上传上限约 384MB   （推荐）
#   8g → 堆约 6g   → 上传上限约 768MB   （大设计型 PPTX）
# ⚠️ 不建议低于 2g：结果仓下限 512MB 会逼近堆，容易 OOM。
MEM_LIMIT=4g

# JVM 参数。MaxRAMPercentage 必须显式给，否则 JVM 只取容器内存的 1/4。
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp

# officia 排版引擎的运维字体目录（多个用 : 分隔）。挂了自备字体就改成 /opt/officia/fonts
OFFICIA_FONTS_DIR=/usr/share/fonts

# 时区
TZ=Asia/Shanghai

# 容器以哪个宿主用户运行（反馈数据卷里的文件归它所有）。宿主上 `id` 查看
DEMO_UID=1000
DEMO_GID=1000

# 「效果不佳的文件」反馈（线上站点才开）：用户主动提交的文件存到 ./data/feedback，后台 https://<站点>/admin
# 不需要就留空，测试台完全无状态
OFFICIA_FEEDBACK_DIR=
# 后台初始口令（账号 admin）。只在第一次生成 data/feedback/admin.json 时使用、存为哈希；之后到后台改
OFFICIA_ADMIN_PASSWORD=
